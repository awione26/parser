# Set true only after obtaining written permission from the Yandex Services operator.
YANDEX_OPERATOR_PERMISSION=false
# Separate confirmation that permission/lawful basis covers collection of contact data.
YANDEX_PHONE_PERMISSION=false
# One-time only: when upgrading a database containing legacy Fernet ciphertext,
# copy the old PHONE_ENCRYPTION_KEY value here. Leave empty on fresh installs and
# remove the value immediately after parser-migrate succeeds.
LEGACY_PHONE_ENCRYPTION_KEY=

# Docker Compose separates schema migrations, parser writes, and admin access.
# Generate four different long random values; never reuse the root password.
MYSQL_ROOT_PASSWORD=replace_with_a_long_random_root_password
MYSQL_MIGRATOR_PASSWORD=replace_with_a_long_random_migrator_password
MYSQL_PARSER_PASSWORD=replace_with_a_long_random_parser_password
MYSQL_ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# Local Python/Alembic fallback when DATABASE_URL is empty. Compose overrides these
# values per service; the direct host workflow intentionally uses the migrator role.
MYSQL_USER=uslugi_migrator
MYSQL_PASSWORD=${MYSQL_MIGRATOR_PASSWORD}

# Laravel admin panel (http://127.0.0.1:8080 when started with Compose).
# Generate ADMIN_APP_KEY with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Keep ADMIN_APP_URL and ADMIN_HOST_PORT aligned when changing the host port.
ADMIN_APP_KEY=
ADMIN_APP_URL=http://127.0.0.1:8080
ADMIN_HOST_PORT=8080
ADMIN_SESSION_SECURE_COOKIE=false
ADMIN_INITIAL_LOGIN=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME="Главный администратор"
# Keep false in normal deployments. This explicit compatibility switch permits
# a 7-11 character initial password without weakening admin-panel form rules.
ADMIN_ALLOW_WEAK_INITIAL_PASSWORD=false

# Optional. If empty, DATABASE_URL is built from the discrete MYSQL_* values above.
DATABASE_URL=

# Bootstrap/fallback values. Migration 20260827_05 seeds the same eleven values in
# MySQL; after that the fixed /cp/settings form and table `settings` are authoritative.
# Network commands stop safely if they cannot read the database configuration.
SCRAPER_USER_AGENT=CompanyName-UslugiParser/0.1 (+mailto:parser-owner@example.com)
SCRAPER_GEO=213-moscow
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_MIN_DELAY_SECONDS=2.0
SCRAPER_MAX_DELAY_SECONDS=5.0
SCRAPER_TIMEOUT_SECONDS=30.0
SCRAPER_MAX_RETRIES=3

# Phone reveal uses the public UI. It never bypasses auth or CAPTCHA.
SCRAPER_COLLECT_PHONE=false
SCRAPER_PHONE_HEADLESS=true
SCRAPER_PHONE_TIMEOUT_SECONDS=15.0

# Organizations usually have no age/gender/FIO, so individual profiles are the default.
SCRAPER_INCLUDE_ORGANIZATIONS=false
