APP_NAME="Парсер мастеров"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
BCRYPT_ROUNDS=12

# Laravel owns only users, sessions, cache and phone_access_logs.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uslugi
DB_USERNAME=admin_application_user
DB_PASSWORD=replace_with_a_long_random_admin_password

# Alembic owns professionals/categories, identity aliases, pivot tables, logs and settings.
# Grant SELECT on parser tables, DELETE only on professionals, and INSERT/UPDATE
# only on settings so the fixed configuration form can repair missing rows.
PARSER_DB_CONNECTION=parser
PARSER_DB_HOST=127.0.0.1
PARSER_DB_PORT=3306
PARSER_DB_DATABASE=uslugi
PARSER_DB_USERNAME=parser_admin_user
PARSER_DB_PASSWORD=replace_with_a_long_random_parser_admin_password

# Seeder creates/updates the first administrator only when both values are set.
# Password must contain at least 12 characters.
ADMIN_INITIAL_LOGIN=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME="Главный администратор"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true behind HTTPS in production.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
